rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // OJO: tener cuenta de Firebase NO es ser de la casa.
    //
    // Cualquiera puede crearse una —con correo y contraseña contra la API key
    // pública, o entrando con Google—, así que `request.auth != null` no
    // distingue a un miembro de un desconocido que se registró hace un minuto.
    // Se conserva porque hay reglas que solo necesitan saber que hay sesión,
    // pero NUNCA debe ser lo único que proteja un dato.
    function estaAutenticado() {
      return request.auth != null;
    }

    // Esta es la frontera de verdad: existe una ficha suya que solo el servidor
    // (Admin SDK) puede crear. Quien no esté dado de alta no pasa de aquí, tenga
    // la cuenta que tenga.
    //
    // A propósito NO se mira `users/{uid}`: ese documento se lo crea el propio
    // navegador al registrarse, así que aceptarlo sería volver al principio.
    function esUsuarioDelSistema() {
      return estaAutenticado()
        && (
          exists(/databases/$(database)/documents/usuarios_roles/$(request.auth.uid))
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function rutaAsignacion() {
      return /databases/$(database)/documents/usuarios_roles/$(request.auth.uid);
    }

    function idMiembro() {
      return request.auth.token.idMiembros;
    }

    function permisoChatExcluido() {
      return exists(rutaAsignacion())
        && 'permisosExcluidos' in get(rutaAsignacion()).data
        && get(rutaAsignacion()).data.permisosExcluidos is list
        && get(rutaAsignacion()).data.permisosExcluidos.hasAny(['chats.ver']);
    }

    function moduloChatDeshabilitado() {
      return exists(rutaAsignacion())
        && 'permisos' in get(rutaAsignacion()).data
        && get(rutaAsignacion()).data.permisos is map
        && 'chats' in get(rutaAsignacion()).data.permisos
        && get(rutaAsignacion()).data.permisos.chats is map
        && 'ver' in get(rutaAsignacion()).data.permisos.chats
        && get(rutaAsignacion()).data.permisos.chats.ver == false;
    }

    function puedeUsarChat() {
      return estaAutenticado()
        && 'idMiembros' in request.auth.token
        && idMiembro() is int
        && !permisoChatExcluido()
        && !moduloChatDeshabilitado();
    }

    function esParticipante(datosConversacion) {
      return puedeUsarChat()
        && datosConversacion.participantesIds is list
        && idMiembro() in datosConversacion.participantesIds;
    }

    function puedeLeerConversacion(idConversacion) {
      return esParticipante(
        get(/databases/$(database)/documents/conversaciones_chat/$(idConversacion)).data
      );
    }

    function conversacion(idConversacion) {
      return get(/databases/$(database)/documents/conversaciones_chat/$(idConversacion)).data;
    }

    function esCreador(datosConversacion) {
      return esParticipante(datosConversacion)
        && datosConversacion.creadoPorIdMiembros == idMiembro();
    }

    function esAdministradorGrupo(datosConversacion) {
      return esParticipante(datosConversacion)
        && (
          datosConversacion.creadoPorIdMiembros == idMiembro()
          || (
            'administradoresIds' in datosConversacion
            && datosConversacion.administradoresIds is list
            && idMiembro() in datosConversacion.administradoresIds
          )
        );
    }

    function camposConversacionPermitidos() {
      return request.resource.data.keys().hasOnly([
        'idConversacion',
        'tipoConversacion',
        'nombreGrupo',
        'avatarGrupoUrl',
        'participantesIds',
        'participantes',
        'creadoPorIdMiembros',
        'administradoresIds',
        'creadoEn',
        'actualizadoEn',
        'ultimoMensaje',
        'noLeidosPorIdMiembros',
        'ocultoAntesPorIdMiembros',
        'silenciadoPorIdMiembros',
        'escribiendoPorIdMiembros',
        'activa',
        'eliminada',
        'versionModelo'
      ]);
    }

    function creacionConversacionValida(idConversacion) {
      return esParticipante(request.resource.data)
        && request.resource.data.idConversacion == idConversacion
        && request.resource.data.creadoPorIdMiembros == idMiembro()
        && request.resource.data.participantesIds.size() >= 2
        && request.resource.data.participantes is list
        && (
          request.resource.data.tipoConversacion != 'GRUPAL'
          || (
            'administradoresIds' in request.resource.data
            && request.resource.data.administradoresIds is list
            && request.resource.data.creadoPorIdMiembros
              in request.resource.data.administradoresIds
          )
        )
        && request.resource.data.tipoConversacion in ['INDIVIDUAL', 'GRUPAL']
        && request.resource.data.eliminada == false
        && camposConversacionPermitidos();
    }

    function actualizacionOperativaConversacionValida() {
      return esParticipante(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'actualizadoEn',
          'ultimoMensaje',
          'noLeidosPorIdMiembros',
          'ocultoAntesPorIdMiembros',
          'silenciadoPorIdMiembros',
          'escribiendoPorIdMiembros'
        ])
        && camposConversacionPermitidos();
    }

    function actualizacionAdministrativaConversacionValida() {
      return esCreador(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'tipoConversacion',
          'nombreGrupo',
          'avatarGrupoUrl',
          'participantesIds',
          'participantes',
          'administradoresIds',
          'actualizadoEn',
          'ultimoMensaje',
          'noLeidosPorIdMiembros',
          'ocultoAntesPorIdMiembros',
          'silenciadoPorIdMiembros',
          'escribiendoPorIdMiembros',
          'activa',
          'eliminada'
        ])
        && request.resource.data.participantesIds is list
        && request.resource.data.participantesIds.size() >= 2
        && camposConversacionPermitidos()
        && (
          request.resource.data.tipoConversacion != 'GRUPAL'
          || estructuraGrupoValida()
        );
    }

    function estructuraGrupoValida() {
      return request.resource.data.tipoConversacion == 'GRUPAL'
        && request.resource.data.participantesIds is list
        && request.resource.data.participantes is list
        && request.resource.data.administradoresIds is list
        && request.resource.data.participantesIds.size() >= 2
        && request.resource.data.participantes.size()
          == request.resource.data.participantesIds.size()
        && request.resource.data.creadoPorIdMiembros in request.resource.data.participantesIds
        && request.resource.data.creadoPorIdMiembros in request.resource.data.administradoresIds
        && request.resource.data.participantesIds.hasAll(
          request.resource.data.administradoresIds
        )
        && camposConversacionPermitidos();
    }

    function actualizacionGrupoPorAdministradorValida() {
      return resource.data.tipoConversacion == 'GRUPAL'
        && esAdministradorGrupo(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombreGrupo',
          'avatarGrupoUrl',
          'participantesIds',
          'participantes',
          'creadoPorIdMiembros',
          'administradoresIds',
          'actualizadoEn',
          'ultimoMensaje',
          'noLeidosPorIdMiembros',
          'silenciadoPorIdMiembros'
        ])
        && (
          idMiembro() == resource.data.creadoPorIdMiembros
          || (
            request.resource.data.creadoPorIdMiembros == resource.data.creadoPorIdMiembros
            && request.resource.data.administradoresIds == resource.data.administradoresIds
          )
        )
        && estructuraGrupoValida();
    }

    function salidaPropiaGrupoValida() {
      return resource.data.tipoConversacion == 'GRUPAL'
        && esParticipante(resource.data)
        && idMiembro() != resource.data.creadoPorIdMiembros
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participantesIds',
          'participantes',
          'administradoresIds',
          'actualizadoEn',
          'ultimoMensaje',
          'noLeidosPorIdMiembros',
          'silenciadoPorIdMiembros'
        ])
        && request.resource.data.participantesIds
          == resource.data.participantesIds.removeAll([idMiembro()])
        && request.resource.data.administradoresIds
          == resource.data.administradoresIds.removeAll([idMiembro()])
        && request.resource.data.participantes.size()
          == resource.data.participantes.size() - 1
        && estructuraGrupoValida();
    }

    function actualizacionConversacionValida() {
      let camposCambiados = request.resource.data.diff(resource.data).affectedKeys();
      let esActualizacionOperativa = camposCambiados.hasOnly([
        'actualizadoEn',
        'ultimoMensaje',
        'noLeidosPorIdMiembros',
        'ocultoAntesPorIdMiembros',
        'silenciadoPorIdMiembros',
        'escribiendoPorIdMiembros'
      ]);
      return esActualizacionOperativa
        ? actualizacionOperativaConversacionValida()
        : resource.data.tipoConversacion == 'GRUPAL'
          ? (
            idMiembro() in request.resource.data.participantesIds
              ? actualizacionGrupoPorAdministradorValida()
              : salidaPropiaGrupoValida()
          )
          : actualizacionAdministrativaConversacionValida();
    }

    function camposMensajePermitidos() {
      return request.resource.data.keys().hasOnly([
        'idMensaje',
        'versionModelo',
        'texto',
        'textoOriginal',
        'tipoContenido',
        'tipoContenidoOriginal',
        'remitenteIdMiembros',
        'remitente',
        'adjuntos',
        'adjuntosOriginales',
        'enviadoEn',
        'actualizadoEn',
        'editado',
        'eliminado',
        'eliminadoEn',
        'respuestaA',
        'mencionesIds',
        'reacciones',
        'metadatos',
        'estadoEntrega',
        'entregadoAIdMiembros',
        'vistoPorIdMiembros'
      ]);
    }

    function mensajeNuevoValido(idMensaje) {
      return request.resource.data.idMensaje == idMensaje
        && request.resource.data.remitenteIdMiembros == idMiembro()
        && request.resource.data.tipoContenido in ['text', 'image', 'file', 'system']
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 20000
        && request.resource.data.adjuntos is list
        && request.resource.data.adjuntos.size() <= 10
        && camposMensajePermitidos();
    }

    function actualizacionMensajePropioValida() {
      return resource.data.remitenteIdMiembros == idMiembro()
        && request.resource.data.remitenteIdMiembros == resource.data.remitenteIdMiembros
        && request.resource.data.idMensaje == resource.data.idMensaje
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'texto',
          'textoOriginal',
          'tipoContenido',
          'tipoContenidoOriginal',
          'adjuntos',
          'adjuntosOriginales',
          'reacciones',
          'actualizadoEn',
          'editado',
          'eliminado',
          'eliminadoEn'
        ])
        && camposMensajePermitidos();
    }

    function actualizacionReaccionValida() {
      return request.resource.data.remitenteIdMiembros == resource.data.remitenteIdMiembros
        && request.resource.data.idMensaje == resource.data.idMensaje
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reacciones',
          'actualizadoEn'
        ])
        && camposMensajePermitidos();
    }

    function camposPresenciaPermitidos() {
      return request.resource.data.keys().hasOnly([
        'idMiembros',
        'estado',
        'estadoManual',
        'estadoManualActualizadoEn',
        'actualizadoEn',
        'sesiones'
      ]);
    }

    function estadoPresenciaValido() {
      return (!('estado' in request.resource.data)
          || request.resource.data.estado in ['online', 'away', 'busy', 'offline', 'always'])
        && (!('estadoManual' in request.resource.data)
          || request.resource.data.estadoManual == null
          || request.resource.data.estadoManual in ['always', 'busy'])
        && (!('sesiones' in request.resource.data) || request.resource.data.sesiones is map);
    }

    function presenciaPropiaValida() {
      return puedeUsarChat()
        && request.resource.data.idMiembros == idMiembro()
        && camposPresenciaPermitidos()
        && estadoPresenciaValido();
    }

    // Identidad y autorizacion para la red social de /principal.
    function tieneIdentidadSocial() {
      return estaAutenticado()
        && 'idMiembros' in request.auth.token
        && request.auth.token.idMiembros is int;
    }

    function esMiembroSocial(valor) {
      return tieneIdentidadSocial() && valor == request.auth.token.idMiembros;
    }

    function esAdministradorSocial() {
      return estaAutenticado()
        && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || (
            exists(rutaAsignacion())
            && (
              (
                'rolId' in get(rutaAsignacion()).data
                && get(rutaAsignacion()).data.rolId in [
                  'admin',
                  'administrador',
                  'administrador_global',
                  'administrador_funcional',
                  'administrador_destacamento',
                  'administrador_seccion',
                  'administrador_region'
                ]
              )
              || (
                'rol' in get(rutaAsignacion()).data
                && get(rutaAsignacion()).data.rol in [
                  'admin',
                  'administrador',
                  'administrador_global',
                  'administrador_funcional'
                ]
              )
            )
          )
        );
    }

    function textoSocialValido(valor, maximo, permiteVacio) {
      return valor is string
        && valor.size() <= maximo
        && (permiteVacio || valor.size() > 0);
    }

    function actualizacionContadoresPublicacionValida() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'cantidadLikes',
          'cantidadComentarios',
          'cantidadCompartidos',
          'cantidadReportes',
          'fechaActualizacion',
          'actualizadoEnServidor'
        ])
        && request.resource.data.cantidadLikes is int
        && request.resource.data.cantidadLikes >= 0
        && request.resource.data.cantidadLikes >= resource.data.cantidadLikes - 1
        && request.resource.data.cantidadLikes <= resource.data.cantidadLikes + 1
        && request.resource.data.cantidadComentarios is int
        && request.resource.data.cantidadComentarios >= resource.data.cantidadComentarios
        && request.resource.data.cantidadComentarios <= resource.data.cantidadComentarios + 1
        && request.resource.data.cantidadCompartidos is int
        && request.resource.data.cantidadCompartidos >= resource.data.cantidadCompartidos
        && request.resource.data.cantidadCompartidos <= resource.data.cantidadCompartidos + 1
        && request.resource.data.cantidadReportes is int
        && request.resource.data.cantidadReportes >= resource.data.cantidadReportes
        && request.resource.data.cantidadReportes <= resource.data.cantidadReportes + 1;
    }

    function eliminacionPropiaPublicacionValida() {
      return esMiembroSocial(resource.data.autorIdMiembros)
        && request.resource.data.estado == 'eliminado'
        && request.resource.data.autorIdMiembros == resource.data.autorIdMiembros
        && request.resource.data.uidAutor == resource.data.uidAutor
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado',
          'eliminadoPorIdMiembros',
          'codigoMiembroEliminadoPor',
          'fechaEliminacion',
          'fechaActualizacion',
          'actualizadoEnServidor'
        ]);
    }

    // `leidoHasta` es OPCIONAL: el recibo se puede crear sin el —la lista de
    // campos permitidos no lo exige— y solo aparece al marcar la conversacion
    // como leida. En estas reglas leer un campo ausente NO devuelve vacio:
    // aborta la evaluacion y deniega la escritura entera, asi que un recibo
    // creado sin marca de lectura no se podia volver a tocar. Preguntando
    // primero si esta, "sin marca" es null y no un error.
    function leidoHastaDe(datos) {
      return 'leidoHasta' in datos ? datos.leidoHasta : null;
    }

    match /conversaciones_chat/{idConversacion} {
      allow get: if esParticipante(resource.data);
      allow list: if estaAutenticado()
        && 'idMiembros' in request.auth.token
        && request.auth.token.idMiembros is int
        && request.auth.token.idMiembros in resource.data.participantesIds;
      allow create: if creacionConversacionValida(idConversacion);
      allow update: if actualizacionConversacionValida();
      allow delete: if esCreador(resource.data);

      match /mensajes/{idMensaje} {
        allow get, list: if puedeLeerConversacion(idConversacion);
        allow create: if puedeLeerConversacion(idConversacion) && mensajeNuevoValido(idMensaje);
        allow update: if puedeLeerConversacion(idConversacion)
          && (actualizacionMensajePropioValida() || actualizacionReaccionValida());
        allow delete: if puedeLeerConversacion(idConversacion)
          && (
            resource.data.remitenteIdMiembros == idMiembro()
            || esCreador(conversacion(idConversacion))
          );
      }

      match /auditoria/{idEvento} {
        allow get, list: if puedeLeerConversacion(idConversacion);
        allow create: if puedeLeerConversacion(idConversacion)
          && request.resource.data.keys().hasOnly([
            'idEvento',
            'accion',
            'actorIdMiembros',
            'idMensaje',
            'creadoEn',
            'detalle'
          ])
          && request.resource.data.idEvento == idEvento
          && request.resource.data.actorIdMiembros == idMiembro();
        allow update: if puedeLeerConversacion(idConversacion)
          && resource.data.actorIdMiembros == idMiembro()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['detalle']);
        allow delete: if false;
      }

      match /recibos/{idRecibo} {
        allow get, list: if puedeLeerConversacion(idConversacion);
        allow create: if puedeLeerConversacion(idConversacion)
          && idRecibo == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'idMiembros',
            'entregadoHasta',
            'leidoHasta',
            'actualizadoEn'
          ])
          && request.resource.data.idMiembros == idMiembro()
          && request.resource.data.entregadoHasta is string
          && (leidoHastaDe(request.resource.data) == null
            || leidoHastaDe(request.resource.data) is string);
        allow update: if puedeLeerConversacion(idConversacion)
          && idRecibo == request.auth.uid
          && resource.data.idMiembros == idMiembro()
          && request.resource.data.idMiembros == resource.data.idMiembros
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'entregadoHasta',
            'leidoHasta',
            'actualizadoEn'
          ])
          && request.resource.data.entregadoHasta is string
          && request.resource.data.entregadoHasta >= resource.data.entregadoHasta
          && (
            leidoHastaDe(request.resource.data) == leidoHastaDe(resource.data)
            || (
              leidoHastaDe(request.resource.data) is string
              && (
                leidoHastaDe(resource.data) == null
                || leidoHastaDe(request.resource.data) >= leidoHastaDe(resource.data)
              )
            )
          );
        allow delete: if false;
      }
    }

    match /presencia_chat/{idDocumento} {
      allow get, list: if puedeUsarChat();
      allow create, update: if presenciaPropiaValida();
      allow delete: if puedeUsarChat() && resource.data.idMiembros == idMiembro();
    }

    match /publicaciones/{idPublicacion} {
      allow get, list: if tieneIdentidadSocial();
      allow create: if tieneIdentidadSocial()
        && request.resource.data.idPublicacion == idPublicacion
        && request.resource.data.uidAutor == request.auth.uid
        && esMiembroSocial(request.resource.data.autorIdMiembros)
        && request.resource.data.archivosMultimedia is list
        && textoSocialValido(request.resource.data.mensaje, 5000,
          request.resource.data.archivosMultimedia.size() > 0)
        && request.resource.data.archivosMultimedia.size() <= 10
        && request.resource.data.visibilidad in ['publico', 'amigos']
        && request.resource.data.estado == 'activo'
        && request.resource.data.cantidadLikes == 0
        && request.resource.data.cantidadComentarios == 0
        && request.resource.data.cantidadCompartidos == 0
        && request.resource.data.cantidadReportes == 0;
      allow update: if tieneIdentidadSocial()
        && (actualizacionContadoresPublicacionValida() || eliminacionPropiaPublicacionValida());
      allow delete: if false;
    }

    match /comentarios_publicaciones/{idComentario} {
      allow get, list: if tieneIdentidadSocial();
      allow create: if tieneIdentidadSocial()
        && request.resource.data.idComentario == idComentario
        && request.resource.data.uidAutor == request.auth.uid
        && esMiembroSocial(request.resource.data.autorIdMiembros)
        && request.resource.data.idPublicacion is string
        && exists(/databases/$(database)/documents/publicaciones/$(request.resource.data.idPublicacion))
        && request.resource.data.imagenURL is string
        && textoSocialValido(request.resource.data.mensaje, 2000,
          request.resource.data.imagenURL.size() > 0)
        && request.resource.data.estado == 'activo';
      allow update, delete: if false;
    }

    match /reacciones_publicaciones/{idReaccion} {
      allow get, list: if tieneIdentidadSocial();
      allow create: if tieneIdentidadSocial()
        && request.resource.data.idReaccion == idReaccion
        && request.resource.data.idPublicacion is string
        && exists(/databases/$(database)/documents/publicaciones/$(request.resource.data.idPublicacion))
        && esMiembroSocial(request.resource.data.usuarioIdMiembros)
        && request.resource.data.tipoReaccion == 'like'
        && request.resource.data.estado == 'activo';
      allow update: if false;
      allow delete: if esMiembroSocial(resource.data.usuarioIdMiembros);
    }

    match /publicaciones_ocultas/{idOculta} {
      allow get, list: if esMiembroSocial(resource.data.usuarioIdMiembros);
      allow create: if esMiembroSocial(request.resource.data.usuarioIdMiembros)
        && request.resource.data.idPublicacionOculta == idOculta
        && request.resource.data.idPublicacion is string;
      allow update: if false;
      allow delete: if esMiembroSocial(resource.data.usuarioIdMiembros);
    }

    match /compartidos_publicaciones/{idCompartido} {
      allow get: if esMiembroSocial(resource.data.compartidoPorIdMiembros);
      allow list: if false;
      allow create: if tieneIdentidadSocial()
        && request.resource.data.idCompartido == idCompartido
        && esMiembroSocial(request.resource.data.compartidoPorIdMiembros)
        && request.resource.data.idPublicacion is string
        && exists(/databases/$(database)/documents/publicaciones/$(request.resource.data.idPublicacion))
        && request.resource.data.tipoDestino in ['enlace', 'chat', 'nativo'];
      allow update, delete: if false;
    }

    match /reportes_publicaciones/{idReporte} {
      allow get: if esAdministradorSocial()
        || esMiembroSocial(resource.data.reportadoPorIdMiembros);
      allow list: if esAdministradorSocial();
      allow create: if tieneIdentidadSocial()
        && request.resource.data.idReporte == idReporte
        && esMiembroSocial(request.resource.data.reportadoPorIdMiembros)
        && request.resource.data.idPublicacion is string
        && exists(/databases/$(database)/documents/publicaciones/$(request.resource.data.idPublicacion))
        && textoSocialValido(request.resource.data.razon, 500, false)
        && request.resource.data.estado == 'pendiente_revision';
      allow update: if esAdministradorSocial()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado',
          'administradorIdMiembros',
          'notaAdministrador',
          'fechaResolucion',
          'actualizadoEnServidor'
        ]);
      allow delete: if false;
    }

    match /galeria_usuarios/{idImagen} {
      allow get, list: if tieneIdentidadSocial();
      allow create: if tieneIdentidadSocial()
        && request.resource.data.idImagen == idImagen
        && esMiembroSocial(request.resource.data.usuarioIdMiembros)
        && request.resource.data.imagenURL is string
        && request.resource.data.imagenURL.size() > 0
        && request.resource.data.estado == 'activo';
      allow update, delete: if esMiembroSocial(resource.data.usuarioIdMiembros);
    }

    match /solicitudes_amistad/{idSolicitud} {
      allow get, list: if tieneIdentidadSocial()
        && (
          resource.data.solicitanteIdMiembros == request.auth.token.idMiembros
          || resource.data.destinatarioIdMiembros == request.auth.token.idMiembros
        );
      allow create: if tieneIdentidadSocial()
        && request.resource.data.idSolicitudAmistad == idSolicitud
        && esMiembroSocial(request.resource.data.solicitanteIdMiembros)
        && request.resource.data.destinatarioIdMiembros is int
        && request.resource.data.destinatarioIdMiembros != request.auth.token.idMiembros
        && request.resource.data.estado == 'pendiente';
      allow update: if esMiembroSocial(resource.data.destinatarioIdMiembros)
        && resource.data.estado == 'pendiente'
        && request.resource.data.estado in ['aceptada', 'eliminada']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado',
          'fechaRespuesta',
          'fechaActualizacion',
          'actualizadoEnServidor'
        ]);
      allow delete: if false;
    }

    match /amistades/{idAmistad} {
      allow get, list: if tieneIdentidadSocial()
        && request.auth.token.idMiembros in resource.data.idsMiembros;
      allow create: if tieneIdentidadSocial()
        && request.resource.data.idAmistad == idAmistad
        && request.resource.data.idsMiembros is list
        && request.resource.data.idsMiembros.size() == 2
        && request.auth.token.idMiembros in request.resource.data.idsMiembros
        && request.resource.data.estado == 'activo'
        && request.resource.data.solicitudOrigenId is string
        && getAfter(/databases/$(database)/documents/solicitudes_amistad/$(request.resource.data.solicitudOrigenId)).data.estado
          == 'aceptada';
      allow update, delete: if false;
    }

    match /seguidores/{idSeguimiento} {
      allow get, list: if tieneIdentidadSocial();
      allow create: if tieneIdentidadSocial()
        && esMiembroSocial(request.resource.data.seguidorIdMiembros)
        && request.resource.data.seguidoIdMiembros is int
        && request.resource.data.seguidoIdMiembros != request.auth.token.idMiembros;
      allow update: if false;
      allow delete: if esMiembroSocial(resource.data.seguidorIdMiembros);
    }

    match /anuncios_principal/{idAnuncio} {
      allow get, list: if tieneIdentidadSocial();
      allow create, update, delete: if esAdministradorSocial();
    }

    // ------------------------------------------------------------------
    // Directivas organizacionales.
    //
    // Las de sección, región y Consejo Nacional son competencia EXCLUSIVA del
    // administrador global. La de un DESTACAMENTO la compone además quien edita
    // las fichas de sus miembros, y solo la de SU destacamento: ver
    // `componeLaDirectivaDeSuDestacamento`. El rol se lee del TOKEN (lo emite el
    // Admin SDK en /api/admin/set-user-claims), no de un documento que el propio
    // usuario pudiera reescribir. Todos los roles pueden CONSULTAR el
    // organigrama.
    // ------------------------------------------------------------------

    function rolDelToken() {
      return request.auth != null && 'rol' in request.auth.token
        ? request.auth.token.rol
        : '';
    }

    // Respaldo para las cuentas cuyo claim aún no se ha emitido (los claims solo
    // se escriben al guardar el rol, y el endpoint degrada en silencio si el
    // servidor no tiene service account). Leer el rol del documento es fiable
    // AHORA porque `usuarios_roles` pasó a ser de solo lectura para el cliente:
    // antes cualquiera podía reescribir el suyo y concederse el rol.
    function rolDelDocumento() {
      return request.auth != null
        && exists(rutaAsignacion())
        && 'rolId' in get(rutaAsignacion()).data
        ? get(rutaAsignacion()).data.rolId
        : '';
    }

    function esAdministradorGlobal() {
      return rolDelToken() == 'administrador_global'
        || rolDelDocumento() == 'administrador_global';
    }

    function nivelDirectivaValido(nivel) {
      return nivel in ['nacional', 'regional', 'seccional', 'destacamento'];
    }

    // Lo que la sincronizacion de cargos escribio en `usuarios_roles/<uid>`:
    // los permisos de TODOS sus cargos y el alcance de cada uno. El documento es
    // de solo lectura para el cliente (ver mas abajo), asi que fiarse de el es
    // fiarse del Admin SDK, no del propio usuario.
    function datosDeAcceso() {
      return request.auth != null && exists(rutaAsignacion())
        ? get(rutaAsignacion()).data
        : {};
    }

    function tienePermisoDeCargo(codigo) {
      return 'permisos' in datosDeAcceso()
        && codigo in datosDeAcceso().permisos;
    }

    function destacamentosDeSuAlcance() {
      return 'alcance' in datosDeAcceso() && 'destacamentos' in datosDeAcceso().alcance
        ? datosDeAcceso().alcance.destacamentos
        : [];
    }

    // La directiva de SU destacamento la compone quien edita las fichas de sus
    // miembros: es la misma responsabilidad sobre la misma gente. Antes hacia
    // falta el Administrador Global hasta para mover una casilla.
    //
    // Solo el nivel DESTACAMENTO y solo el suyo. Seccion, region y Consejo
    // Nacional siguen siendo del Administrador Global —ademas de pasar por la
    // aprobacion de la Oficina Nacional—. Que el Coordinador se entere de lo que
    // movio otro cargo es cosa del aviso que manda la app, no de esta regla.
    function componeLaDirectivaDeSuDestacamento(nivel, idEntidad) {
      return nivel == 'destacamento'
        && tienePermisoDeCargo('miembros.editar')
        && string(idEntidad) in destacamentosDeSuAlcance();
    }

    match /asignacionesDirectiva/{idAsignacion} {
      allow read: if esUsuarioDelSistema();
      allow create, update: if (
          esAdministradorGlobal()
          || componeLaDirectivaDeSuDestacamento(
               request.resource.data.nivel,
               request.resource.data.idEntidad
             )
        )
        && request.resource.data.idAsignacion == idAsignacion
        && nivelDirectivaValido(request.resource.data.nivel)
        && request.resource.data.idPosicionDirectiva is string
        && request.resource.data.idPosicionDirectiva.size() > 0
        && request.resource.data.idMiembro is string
        && request.resource.data.activo is bool;
      // Nunca se borra: liberar un cargo es dar de baja la asignación
      // (activo=false con fechaFin), que es lo que conserva el histórico.
      allow delete: if false;
    }

    match /directivasOrganizacionales/{idDirectiva} {
      allow read: if esUsuarioDelSistema();
      allow create, update: if (
          esAdministradorGlobal()
          || componeLaDirectivaDeSuDestacamento(
               request.resource.data.nivel,
               request.resource.data.idEntidad
             )
        )
        && request.resource.data.idDirectiva == idDirectiva
        && nivelDirectivaValido(request.resource.data.nivel);
      allow delete: if false;
    }

    match /posicionesDirectiva/{idPosicion} {
      allow read: if esUsuarioDelSistema();
      allow write: if esAdministradorGlobal();
    }

    match /disenosDirectiva/{idDiseno} {
      allow read: if esUsuarioDelSistema();
      allow create, update: if (
          esAdministradorGlobal()
          || componeLaDirectivaDeSuDestacamento(
               request.resource.data.nivel,
               request.resource.data.idEntidad
             )
        )
        && request.resource.data.nodeOffsets is map
        && request.resource.data.containerHeightOffset is int;
      allow delete: if false;
    }

    // El nombre real de la colección lleva guiones bajos. Esta regla estaba
    // escrita en camelCase, así que no casaba con nada: el organigrama caía en
    // el comodín de abajo y lo escribía cualquiera con sesión. Se dejan las dos
    // grafías porque la vieja pudo llegar a usarse en algún entorno.
    // Escribe quien asigna cargos —el formulario del miembro lo sincroniza al
    // guardar—, no solo el Administrador Global: dejarlo en global rompía la
    // asignación de cargos del Coordinador. Se cierra a los usuarios del
    // sistema, que es lo que de verdad estaba abierto.
    //
    // PENDIENTE: limitarlo a quien tenga el permiso de asignar cargos exige
    // modelar ese permiso en las reglas.
    match /organigrama_directiva_destacamentos/{idAsignacion} {
      allow read, write: if esUsuarioDelSistema();
    }

    match /organigramaDirectivaDestacamentos/{idAsignacion} {
      allow read, write: if esUsuarioDelSistema();
    }

    // El rol de cada usuario y la lista de administradores solo los escribe el
    // Admin SDK. Eran escribibles por el comodín de abajo, así que cualquiera
    // podía concederse el rol que quisiera — y `admins/{uid}` es justo lo que
    // consulta esAdministradorSocial().
    match /usuarios_roles/{idUsuario} {
      allow read: if esUsuarioDelSistema();
      allow write: if false;
    }

    match /admins/{idUsuario} {
      allow read: if esUsuarioDelSistema();
      allow write: if false;
    }

    // Las huellas de las contraseñas y la del código de un solo uso.
    //
    // Ninguna deja volver a la clave, pero las dos se pueden atacar SIN
    // CONEXIÓN: quien se las lleve prueba contra ellas todo el diccionario que
    // quiera, a su ritmo y sin que nadie lo vea. Vivían dentro de
    // `usuarios_roles`, que cualquiera con sesión puede leer entera.
    //
    // Aquí no entra nadie: solo el Admin SDK, que se salta las reglas.
    match /secretos_acceso/{idUsuario} {
      allow read, write: if false;
    }

    // El catálogo de lo que puede hacer cada combinación de cargos. Lo lee
    // cualquiera con sesión —de él salen los permisos— pero solo lo escribe el
    // Administrador Global: quien pudiera editarlo se concedería lo que quisiera.
    match /combinaciones_roles/{idCombinacion} {
      allow read: if esUsuarioDelSistema();
      allow write: if esAdministradorGlobal();
    }

    // La bitácora es la prueba de quién cambió qué: se añade, nunca se corrige
    // ni se borra desde el cliente.
    match /auditoria_sistema/{idEvento} {
      allow read: if esUsuarioDelSistema();
      allow create: if esUsuarioDelSistema();
      allow update, delete: if false;
    }

    // Compatibilidad del resto de la aplicación: exige autenticación sin ampliar
    // el acceso especial del chat. Las reglas específicas de otros módulos deben
    // continuar endureciéndose en sus propias fases.
    //
    // PENDIENTE: este comodín sigue concediendo escritura a cualquier usuario
    // autenticado sobre toda colección no listada arriba. Cerrarlo exige
    // inventariar el resto de los módulos y darles su propio bloque; hacerlo de
    // golpe rompería la aplicación.
    match /{coleccion}/{documento=**} {
      allow read, write: if coleccion != 'conversaciones_chat'
        && coleccion != 'presencia_chat'
        && coleccion != 'publicaciones'
        && coleccion != 'comentarios_publicaciones'
        && coleccion != 'reacciones_publicaciones'
        && coleccion != 'reportes_publicaciones'
        && coleccion != 'publicaciones_ocultas'
        && coleccion != 'compartidos_publicaciones'
        && coleccion != 'seguidores'
        && coleccion != 'amistades'
        && coleccion != 'solicitudes_amistad'
        && coleccion != 'galeria_usuarios'
        && coleccion != 'anuncios_principal'
        // Las reglas de Firestore se SUMAN: sin excluir estas colecciones, el
        // comodín volvería a conceder la escritura que los bloques de arriba
        // reservan al administrador global.
        && coleccion != 'asignacionesDirectiva'
        && coleccion != 'directivasOrganizacionales'
        && coleccion != 'posicionesDirectiva'
        && coleccion != 'disenosDirectiva'
        && coleccion != 'organigramaDirectivaDestacamentos'
        && coleccion != 'organigrama_directiva_destacamentos'
        && coleccion != 'usuarios_roles'
        && coleccion != 'admins'
        && coleccion != 'secretos_acceso'
        && coleccion != 'auditoria_sistema'
        && coleccion != 'combinaciones_roles'
        && esUsuarioDelSistema();
    }
  }
}
