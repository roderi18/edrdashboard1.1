rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function estaAutenticado() {
      return request.auth != null;
    }

    // Requiere que el agente administrado de Firebase Storage tenga
    // roles/firebaserules.firestoreServiceAgent para resolver estos perfiles.
    function rutaUsuario(coleccion) {
      return /databases/(default)/documents/$(coleccion)/$(request.auth.uid);
    }

    function tieneDocumento(coleccion) {
      return estaAutenticado() && firestore.exists(rutaUsuario(coleccion));
    }

    function documentoUsuario(coleccion) {
      return firestore.get(rutaUsuario(coleccion));
    }

    function esRolAdministrativo(rol) {
      return rol in [
        'admin',
        'administrador',
        'administrador_global',
        'administrador_funcional',
        'administrador_destacamento',
        'administrador_seccion',
        'administrador_region'
      ];
    }

    function esAdminRegistrado() {
      return tieneDocumento('admins')
        || (
          tieneDocumento('users')
          && (
            esRolAdministrativo(documentoUsuario('users').data.rol)
            || esRolAdministrativo(documentoUsuario('users').data.role)
          )
        )
        || (
          tieneDocumento('usuarios_roles')
          && (
            esRolAdministrativo(documentoUsuario('usuarios_roles').data.rol)
            || esRolAdministrativo(documentoUsuario('usuarios_roles').data.role)
            || esRolAdministrativo(documentoUsuario('usuarios_roles').data.rolId)
          )
        );
    }

    // `admin` es la identidad legada de la cuenta administrativa principal
    // (admin001). No se incluye `administrador`: ese valor tambien lo usan cargos
    // organizacionales que no deben recibir privilegios globales.
    function esRolAdministradorGlobal(rol) {
      return rol in ['admin', 'administrador_global'];
    }

    function documentoTieneRolAdministradorGlobal(coleccion) {
      return tieneDocumento(coleccion)
        && (
          (
            'rolId' in documentoUsuario(coleccion).data
            && esRolAdministradorGlobal(documentoUsuario(coleccion).data.rolId)
          )
          || (
            'roleId' in documentoUsuario(coleccion).data
            && esRolAdministradorGlobal(documentoUsuario(coleccion).data.roleId)
          )
          || (
            'rol' in documentoUsuario(coleccion).data
            && esRolAdministradorGlobal(documentoUsuario(coleccion).data.rol)
          )
          || (
            'role' in documentoUsuario(coleccion).data
            && esRolAdministradorGlobal(documentoUsuario(coleccion).data.role)
          )
        );
    }

    // El Administrador Global es el unico rol con acceso transversal para crear
    // o reemplazar imagenes en cualquier modulo. Se consulta primero el custom
    // claim y se conservan los documentos de perfil como respaldo mientras el
    // token renovado aun no ha llegado al cliente.
    function esAdministradorGlobal() {
      return estaAutenticado()
        && (
          (
            'rol' in request.auth.token
            && esRolAdministradorGlobal(request.auth.token.rol)
          )
          || documentoTieneRolAdministradorGlobal('usuarios_roles')
          || documentoTieneRolAdministradorGlobal('users')
          || documentoTieneRolAdministradorGlobal('admins')
        );
    }

    function tienePermisoDirecto(codigoPermiso) {
      return tieneDocumento('usuarios_roles')
        && documentoUsuario('usuarios_roles').data.permisos is list
        && documentoUsuario('usuarios_roles').data.permisos.hasAny([codigoPermiso]);
    }

    function tienePermisoPorRol(codigoPermiso) {
      return tieneDocumento('usuarios_roles')
        && firestore.exists(
          /databases/(default)/documents/roles/$(documentoUsuario('usuarios_roles').data.rolId)
        )
        && firestore.get(
          /databases/(default)/documents/roles/$(documentoUsuario('usuarios_roles').data.rolId)
        ).data.permisos is list
        && firestore.get(
          /databases/(default)/documents/roles/$(documentoUsuario('usuarios_roles').data.rolId)
        ).data.permisos.hasAny([codigoPermiso]);
    }

    function permisoExcluido(codigoPermiso) {
      return tieneDocumento('usuarios_roles')
        && documentoUsuario('usuarios_roles').data.permisosExcluidos is list
        && documentoUsuario('usuarios_roles').data.permisosExcluidos.hasAny([codigoPermiso]);
    }

    function rolBaseTienePermiso(codigoPermiso) {
      return tieneDocumento('usuarios_roles')
        && (
          (
            codigoPermiso == 'miembros.subir_foto'
            && documentoUsuario('usuarios_roles').data.rolId in [
              'usuario_destacamento',
              'usuario_seccion',
              'consejo_ejecutivo',
              'administrador_global',
              'administrador_funcional'
            ]
          )
          || (
            codigoPermiso == 'destacamentos.subir_foto'
            && documentoUsuario('usuarios_roles').data.rolId in [
              'usuario_destacamento',
              'usuario_seccion',
              'usuario_seccion_asistente',
              'administrador_global'
            ]
          )
        );
    }

    function tienePermiso(codigoPermiso) {
      return !permisoExcluido(codigoPermiso)
        && (
          esAdminRegistrado()
          || tienePermisoDirecto(codigoPermiso)
          || tienePermisoPorRol(codigoPermiso)
          || rolBaseTienePermiso(codigoPermiso)
        );
    }

    function esImagenPermitida() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function esArchivoPerfil(archivo) {
      return archivo.matches('perfil\\.(jpg|jpeg|png|webp)');
    }

    // Documentos de la Dispensa Médica (PDF/imagen, hasta 15 MB).
    function esArchivoSaludPermitido() {
      return request.resource != null
        && request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('image/.*')
        );
    }

    function rolDeUsuario() {
      return documentoUsuario('usuarios_roles').data.rolId;
    }

    // Estos cargos son de consulta aun si el catalogo remoto o una asignacion
    // antigua conserva permisos directos de escritura.
    function esCargoDestacamentoSoloLectura() {
      return tieneDocumento('usuarios_roles')
        && rolDeUsuario() in [
          'pastor_destacamento',
          'consejo_destacamento',
          'capellan_destacamento'
        ];
    }

    // Cargos que pueden SUBIR documentos de salud: coordinadores de destacamento y
    // el resto de cargos del destacamento (pastor, consejo, capellán, líderes),
    // más seccion/region.
    function puedeSubirDocumentoSalud() {
      return tieneDocumento('usuarios_roles')
        && rolDeUsuario() in [
          'usuario_destacamento',
          'usuario_destacamento_asistente',
          'pastor_destacamento',
          'consejo_destacamento',
          'capellan_destacamento',
          'lider_grupo',
          'lider_asistente_grupo',
          'usuario_seccion',
          'usuario_seccion_asistente',
          'usuario_region',
          'usuario_region_asistente'
        ];
    }

    // Cargos que pueden ELIMINAR documentos de salud: coordinadores de destacamento
    // y niveles superiores (los cargos en flujo de aprobación solo pueden subir).
    function puedeEliminarDocumentoSalud() {
      return tieneDocumento('usuarios_roles')
        && rolDeUsuario() in [
          'usuario_destacamento',
          'usuario_destacamento_asistente',
          'usuario_seccion',
          'usuario_seccion_asistente',
          'usuario_region',
          'usuario_region_asistente'
        ];
    }

    // Cualquier usuario autenticado con una identidad registrada (admin, users o
    // usuarios_roles). Sirve de respaldo para no depender del campo rolId exacto,
    // que puede faltar en algunos documentos. El control fino de "quién puede
    // subir/eliminar" lo aplica la app.
    function esUsuarioRegistrado() {
      return tieneDocumento('admins')
        || tieneDocumento('users')
        || tieneDocumento('usuarios_roles');
    }

    function idMiembroChat() {
      return request.auth.token.idMiembros;
    }

    function puedeUsarChat() {
      return estaAutenticado()
        && 'idMiembros' in request.auth.token
        && idMiembroChat() is int;
    }

    function rutaConversacionChat(idConversacion) {
      return /databases/(default)/documents/conversaciones_chat/$(idConversacion);
    }

    function esParticipanteChat(idConversacion) {
      return puedeUsarChat()
        && firestore.exists(rutaConversacionChat(idConversacion))
        && firestore.get(rutaConversacionChat(idConversacion)).data.participantesIds is list
        && idMiembroChat() in firestore.get(
          rutaConversacionChat(idConversacion)
        ).data.participantesIds;
    }

    function esCreadorChat(idConversacion) {
      return esParticipanteChat(idConversacion)
        && firestore.get(rutaConversacionChat(idConversacion)).data.creadoPorIdMiembros
          == idMiembroChat();
    }

    function nombreArchivoChatValido(archivo) {
      return archivo.matches('[a-zA-Z0-9][a-zA-Z0-9._-]{0,179}');
    }

    function metadatosChatValidos(idConversacion, tipo) {
      return request.resource.metadata.modulo == 'chat'
        && request.resource.metadata.tipo == tipo
        && request.resource.metadata.idConversacion == idConversacion
        && request.resource.metadata.uploaderUid == request.auth.uid;
    }

    function imagenChatValida(idConversacion, archivo) {
      return nombreArchivoChatValido(archivo)
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'image/gif'
        ]
        && metadatosChatValidos(idConversacion, 'imagen');
    }

    function documentoChatValido(idConversacion, archivo) {
      return nombreArchivoChatValido(archivo)
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/zip',
          'application/x-zip-compressed'
        ]
        && metadatosChatValidos(idConversacion, 'archivo');
    }

    function imagenPrincipalValida(idPublicacion, archivo) {
      return archivo.matches('[a-zA-Z0-9][a-zA-Z0-9._-]{0,179}')
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'image/gif'
        ]
        && request.resource.metadata.idPublicacion == idPublicacion
        && request.resource.metadata.tipo in ['publicacion', 'comentario']
        && request.resource.metadata.uploaderUid == request.auth.uid;
    }

    match /chat/{idConversacion}/imagenes/{archivo} {
      allow read: if esParticipanteChat(idConversacion);
      allow create: if esParticipanteChat(idConversacion)
        && resource == null
        && imagenChatValida(idConversacion, archivo);
      allow update: if false;
      allow delete: if esParticipanteChat(idConversacion)
        && (resource.metadata.uploaderUid == request.auth.uid
          || esCreadorChat(idConversacion));
    }

    match /chat/{idConversacion}/archivos/{archivo} {
      allow read: if esParticipanteChat(idConversacion);
      allow create: if esParticipanteChat(idConversacion)
        && resource == null
        && documentoChatValido(idConversacion, archivo);
      allow update: if false;
      allow delete: if esParticipanteChat(idConversacion)
        && (resource.metadata.uploaderUid == request.auth.uid
          || esCreadorChat(idConversacion));
    }

    match /principal/{idPublicacion}/{archivo} {
      allow read: if estaAutenticado();
      allow create: if estaAutenticado()
        && resource == null
        && imagenPrincipalValida(idPublicacion, archivo);
      allow update: if false;
      allow delete: if estaAutenticado()
        && resource.metadata.uploaderUid == request.auth.uid;
    }

    // Certificados PDF del Sistema de Ascenso / Academia Ministerial (subidos por
    // el coordinador/lider al marcar un item como completado) y lotes de
    // certificados generados por administracion. Cualquier cargo de solo lectura
    // (Pastor, Consejo, Capellan) queda excluido aunque conserve un permiso
    // directo heredado.
    function puedeGestionarCertificadosAscenso() {
      return !esCargoDestacamentoSoloLectura()
        && (esAdminRegistrado() || tienePermiso('ascenso.editar'));
    }

    match /certificados/{allPaths=**} {
      allow read: if estaAutenticado();
      allow write: if estaAutenticado() && puedeGestionarCertificadosAscenso();
    }

    match /documentos-salud-miembros/{idMiembro}/{archivo} {
      allow read: if estaAutenticado();
      allow create, update: if estaAutenticado()
        && esArchivoSaludPermitido()
        && !esCargoDestacamentoSoloLectura()
        && (esAdminRegistrado() || tienePermiso('salud.subir_documentos'));
      allow delete: if estaAutenticado()
        && !esCargoDestacamentoSoloLectura()
        && (esAdminRegistrado() || tienePermiso('salud.eliminar_documentos'));
    }

    match /miembros/{idMiembro}/{archivo} {
      allow read: if estaAutenticado();
      allow write: if esArchivoPerfil(archivo)
        && tienePermiso('miembros.subir_foto')
        && esImagenPermitida();
    }

    match /destacamentos/{idDestacamento}/{archivo} {
      allow read: if estaAutenticado();
      allow write: if esArchivoPerfil(archivo)
        && tienePermiso('destacamentos.subir_foto')
        && esImagenPermitida();
    }

    // Superposicion deliberada: las reglas de Storage son aditivas. Este bloque
    // permite al Administrador Global agregar o reemplazar cualquier imagen,
    // incluidas las fotos de secciones y regiones que no tienen un match propio.
    // No concede borrado ni permite subir archivos que no sean imagenes.
    match /{rutaImagen=**} {
      allow read: if esAdministradorGlobal()
        && resource.contentType.matches('image/.*');
      allow create, update: if esAdministradorGlobal()
        && esImagenPermitida();
    }
  }
}
